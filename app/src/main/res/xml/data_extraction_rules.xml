<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include all shared preferences (like playback_prefs and secure_server_config) -->
        <include domain="sharedpref" path="." />
        
        <!-- Include the local Room database containing library, bookshelves, and state -->
        <include domain="database" path="." />
        
        <!-- Include any internal files -->
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Include all shared preferences (like playback_prefs and secure_server_config) -->
        <include domain="sharedpref" path="." />
        
        <!-- Include the local Room database containing library, bookshelves, and state -->
        <include domain="database" path="." />
        
        <!-- Include any internal files -->
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
